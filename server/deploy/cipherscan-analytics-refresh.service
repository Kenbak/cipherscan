[Unit]
Description=Repair completed recent daily analytics
After=network-online.target postgresql.service
[Service]
Type=oneshot
WorkingDirectory=/root/cipherscan
Environment=NODE_PATH=/root/cipherscan/server/api/node_modules
ExecStart=/usr/bin/node server/jobs/backfill-analytics-history.js --apply --refresh --max-days=7 --pause-ms=10000
ExecStartPost=/usr/bin/node server/jobs/check-analytics-completeness.js
TimeoutStartSec=1200
Nice=15
IOSchedulingClass=idle
CPUWeight=10
IOWeight=10
MemoryMax=1G
UMask=0077
