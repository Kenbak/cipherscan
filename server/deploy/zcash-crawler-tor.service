[Unit]
Description=Ziggurat Zcash Network Crawler (via Tor)
After=network-online.target tor@default.service
Wants=network-online.target
Requires=tor@default.service

StartLimitIntervalSec=900
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=/opt/zcash-crawler
ExecStart=/opt/zcash-crawler/target/release/crawler \
  --socks5-proxy 127.0.0.1:9050 \
  --seed-addrs mainnet.seeder.zfnd.org dnsseed.str4d.xyz \
  --node-listening-port 8233 \
  --rpc-addr 127.0.0.1:54322
Restart=always
RestartSec=30
TimeoutStopSec=30

LimitNOFILE=2048
MemoryMax=1G
MemoryHigh=768M
CPUQuota=25%


NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/opt/zcash-crawler/data

[Install]
WantedBy=multi-user.target
