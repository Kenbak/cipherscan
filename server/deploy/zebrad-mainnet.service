[Unit]
Description=Zebra Zcash Node (Mainnet)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/zebrad -c /root/.config/zebrad/zebrad.toml start
Restart=always
RestartSec=10
TimeoutStopSec=300
LimitNOFILE=65536
Environment=RUST_LOG=info

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/mnt/data /root/.cache/zebra
ReadOnlyPaths=/root/.config/zebrad

[Install]
WantedBy=multi-user.target
